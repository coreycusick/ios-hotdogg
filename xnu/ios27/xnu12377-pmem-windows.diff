+/*
+ * 2026-11-26: was 16. wland alone touches ~12 windows (its 16 MB ring/buffer pool at 0xe0000000 is 8, plus WCSS,
+ * SMEM, APCS IPC, TCSR, QMP), adspd its 15 MB FastRPC heap (8) and more, btbridge its own: with 16 shared round robin
+ * nearly every access remapped a window (ml_io_unmap + ml_io_map_unmappable: kernel VM work and a TLB flush on all
+ * CPUs). 64 x 2 MB = 128 MB of kernel VA. kern.sweet_pmem_stats counts hits and remaps.
+ */
+#define PMEM_MAPS       64              /* 2 MB device windows, round robin */
