+
+/*
+ * 2026-11-26: /dev/pmem PMEM_MAP (bsd/dev/sweet_pmem.c). Maps physical memory the kernel does not manage
+ * (registers, carve-outs, the wland/adspd pools) into the calling process as device memory, the same attributes
+ * /dev/pmem's own windows use (VM_WIMG_IO), so wland/adspd/btbridge read and write it with plain loads and stores
+ * instead of one pread/pwrite per access (~48,000 system calls a second at idle). The IOMemoryMap is kept here,
+ * with the pid; maps of processes that are gone are released when a new map is asked for.
+ */
+#include <IOKit/IOMemoryDescriptor.h>
+#include <IOKit/IOLocks.h>
+#include <sys/proc.h>
+#include <sys/errno.h>
+
+#define SWEET_UMAPS 256
+static struct {
+	int pid;
+	IOMemoryMap *map;
+} sweet_umaps[SWEET_UMAPS];
+static IOLock *sweet_umap_lock;
+
+extern "C" int sweet_pmem_map_user(uint64_t pa, uint64_t size, uint64_t *uaddr);
+
+extern "C" int
+sweet_pmem_map_user(uint64_t pa, uint64_t size, uint64_t *uaddr)
+{
+	if (sweet_umap_lock == NULL) {
+		IOLock *l = IOLockAlloc();
+		if (!OSCompareAndSwapPtr(NULL, l, (void * volatile *)&sweet_umap_lock)) {
+			IOLockFree(l);
+		}
+	}
+	IOMemoryDescriptor *md = IOMemoryDescriptor::withAddressRange(pa, size, kIODirectionInOut, TASK_NULL);
+	if (md == NULL) {
+		return ENOMEM;
+	}
+	IOMemoryMap *map = md->createMappingInTask(current_task(), 0, kIOMapAnywhere | kIOMapInhibitCache);
+	md->release();
+	if (map == NULL) {
+		return ENOMEM;
+	}
+	int pid = proc_selfpid(), slot = -1;
+	IOLockLock(sweet_umap_lock);
+	for (int i = 0; i < SWEET_UMAPS; i++) {
+		if (sweet_umaps[i].map != NULL) {
+			proc_t p = proc_find(sweet_umaps[i].pid);
+			if (p == NULL) {
+				sweet_umaps[i].map->release();
+				sweet_umaps[i].map = NULL;
+			} else {
+				proc_rele(p);
+			}
+		}
+		if (sweet_umaps[i].map == NULL && slot < 0) {
+			slot = i;
+		}
+	}
+	if (slot >= 0) {
+		sweet_umaps[slot].pid = pid;
+		sweet_umaps[slot].map = map;
+	}
+	IOLockUnlock(sweet_umap_lock);
+	if (slot < 0) {
+		map->release();
+		return ENOSPC;
+	}
+	*uaddr = map->getAddress();
+	return 0;
+}
