+/*
+ * 2026-11-26 profiler (bsd/dev/sweet_sample.c, sysctl kern.sweet_profile): the user stacks of the threads of TASK that
+ * are running or waiting for a CPU right now (blocked threads use no CPU and are left out). A thread on another CPU
+ * saves its user registers only when it enters the kernel, so those CPUs get an AST IPI first and the saved state is
+ * where the thread is now, not where its last system call was. out: per thread `depth` slots, pc, lr, then the
+ * frame-pointer chain, ended by 0. Returns the number of threads written.
+ */
+int sweet_profile_stacks(task_t task, uint64_t *out, int max_threads, int depth);
+int sweet_profile_images(task_t task, uint64_t cache_lo, uint64_t cache_hi, char *s, int cap);
+void sweet_profile_task_info(task_t task, uint64_t *slide, uint64_t *mh);
+
+/* The shared region slide and the main binary's mach header, as sweet_sample_task prints them. */
+void
+sweet_profile_task_info(task_t task, uint64_t *slide, uint64_t *mh)
+{
+	vm_shared_region_t sr = vm_shared_region_get(task);
+	*slide = 0;
+	if (sr != NULL) {
+		*slide = sr->sr_slide;
+		vm_shared_region_deallocate(sr);
+	}
+	*mh = task->mach_header_vm_address;
+}
+
+int
+sweet_profile_stacks(task_t task, uint64_t *out, int max_threads, int depth)
+{
+	vm_map_t map = get_task_map(task);
+	processor_t self = current_processor();
+	thread_t thread;
+	int nt = 0, kicked = 0;
+
+	task_lock(task);
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		processor_t p = thread->last_processor;
+		if ((thread->state & (TH_RUN | TH_WAIT)) == TH_RUN && p != PROCESSOR_NULL && p != self &&
+		    p->active_thread == thread) {
+			cause_ast_check(p);
+			kicked++;
+		}
+	}
+	if (kicked) {
+		delay(20);      /* the IPI'd threads trap and save their user state */
+	}
+	queue_iterate(&task->threads, thread, thread_t, task_threads) {
+		if (nt >= max_threads) {
+			break;
+		}
+		if ((thread->state & (TH_RUN | TH_WAIT)) != TH_RUN) {
+			continue;
+		}
+		arm_saved_state_t *ss = find_user_regs(thread);
+		if (ss == NULL || !is_saved_state64(ss)) {
+			continue;
+		}
+		uint64_t *o = out + (size_t)nt * (size_t)depth;
+		uint64_t fp = get_saved_state_fp(ss);
+		int i = 0;
+		o[i++] = get_saved_state_pc(ss);
+		o[i++] = get_saved_state_lr(ss);
+		while (i < depth - 1 && fp != 0 && (fp & 7) == 0) {
+			uint64_t frame[2];
+			if (vm_map_read_user(map, fp, frame, sizeof(frame)) != KERN_SUCCESS) {
+				break;
+			}
+			o[i++] = frame[1];
+			if (frame[0] <= fp) {
+				break;
+			}
+			fp = frame[0];
+		}
+		o[i] = 0;
+		nt++;
+	}
+	task_unlock(task);
+	return nt;
+}
+
+/*
+ * The images dyld has loaded outside the shared cache (the main binary, plugins such as AdrenoMetal), from the
+ * task's dyld_all_image_infos: "img LOAD PATH" lines into s. Returns the length written.
+ */
+int
+sweet_profile_images(task_t task, uint64_t cache_lo, uint64_t cache_hi, char *s, int cap)
+{
+	vm_map_t map = get_task_map(task);
+	uint64_t info = task->all_image_info_addr;
+	struct {
+		uint32_t version, count;
+		uint64_t array;
+	} head;
+	int n = 0;
+
+	if (info == 0 || vm_map_read_user(map, info, &head, sizeof(head)) != KERN_SUCCESS || head.array == 0) {
+		return snprintf(s, cap, "img none (no dyld image list)\n");
+	}
+	for (uint32_t i = 0; i < head.count && i < 4096 && n < cap - 300; i++) {
+		uint64_t e[3];  /* load address, path, mod date */
+		char path[220];
+		if (vm_map_read_user(map, head.array + 24ull * i, e, sizeof(e)) != KERN_SUCCESS) {
+			break;
+		}
+		if (e[0] >= cache_lo && e[0] < cache_hi) {
+			continue;
+		}
+		path[0] = 0;
+		if (e[1] == 0 || vm_map_read_user(map, e[1], path, sizeof(path)) != KERN_SUCCESS) {
+			strlcpy(path, "?", sizeof(path));
+		}
+		path[sizeof(path) - 1] = 0;
+		n += snprintf(s + n, cap - n, "img 0x%llx %s\n", e[0], path);
+	}
+	return n;
+}
+
